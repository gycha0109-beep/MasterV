{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterV",
  "version": "0.1.0",
  "identifier": "com.masterv.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "title": "MasterV",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://euqkjrmrhhvnyzasppnd.supabase.co; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
